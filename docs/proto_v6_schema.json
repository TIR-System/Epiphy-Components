{
  "$comment": "Epiphy 2D Surface Protocol v6 standalone machine-readable conformance schema (cross-language target for KubeJS & future Kotlin/Java native mod)",
  "schemaVersion": "6.3.0",
  "protoVersion": 6,
  "compatibleProtoVersions": [5, 6],
  "channel": "epiphy:screen_danmaku",
  "officialAliases": {
    "envelope": {
      "act": "action",
      "carrier": "surface",
      "layers": "nodes",
      "texMap": "replaceTextures",
      "bg": "bgNodes",
      "fg": "fgNodes",
      "at": "worldPos",
      "facing": "billboard",
      "xray": "seeThrough",
      "shake": "shakeMode",
      "zIndex": "renderPriority",
      "text": "title",
      "subtitle": "sub",
      "id": "slotId",
      "size": "scale",
      "tilt": "angle",
      "duration": "stay",
      "hold": "activeHold",
      "fade": "fadeStyle",
      "fadeTicks": "fadeOut",
      "outline": "outlineMode",
      "ns": "namespace"
    },
    "node": {
      "kind": "type",
      "tint": "color",
      "tex": "texture",
      "items": "children"
    }
  },
  "actions": ["push", "patch", "deactivate", "clear"],
  "surfaces": ["screen", "gui", "slot", "world_plane"],
  "tiers": ["system", "player"],
  "lifeModes": ["once", "active", "screen_session"],
  "defaultRenderPriority": {
    "screen": 0,
    "screen_hud": 50,
    "gui": 100,
    "slot": 200,
    "world_plane": 0
  },
  "requiredByAction": {
    "push": ["proto", "surface", "action", "tier", "namespace", "group", "lifeMode", "priority", "renderPriority"],
    "patch": ["proto", "surface", "action", "tier", "slotId", "namespace", "group", "vars"],
    "deactivate": ["proto", "surface", "action", "tier", "key", "group", "namespace"],
    "clear": ["proto", "surface", "action", "tier", "group", "namespace"]
  },
  "envelope": {
    "proto":               { "type": "number",  "enum": [5, 6] },
    "action":              { "type": "string",  "enum": ["push", "patch", "deactivate", "clear"] },
    "surface":             { "type": "string",  "enum": ["screen", "gui", "slot", "world_plane"] },
    "tier":                { "type": "string",  "enum": ["system", "player"] },
    "key":                 { "type": "string",  "maxLen": 256 },
    "slotId":              { "type": "string",  "maxLen": 128 },
    "namespace":           { "type": "string",  "maxLen": 64 },
    "group":               { "type": "string",  "maxLen": 64 },
    "posTag":              { "type": "string" },
    "normalizeKey":        { "type": "boolean" },
    "lifeMode":            { "type": "string",  "enum": ["once", "active", "screen_session"] },
    "priority":            { "type": "number",  "min": 0, "max": 10 },
    "maxPriority":         { "type": "number",  "min": 0, "max": 10 },
    "includeOnce":         { "type": "boolean" },
    "renderPriority":      { "type": "number",  "min": -10000, "max": 10000 },
    "title":               { "type": "string",  "maxLen": 2048 },
    "sub":                 { "type": "string",  "maxLen": 1024 },
    "rx":                  { "type": "number",  "min": 0.0, "max": 1.0 },
    "ry":                  { "type": "number",  "min": 0.0, "max": 1.0 },
    "ox":                  { "type": "number",  "min": -4096, "max": 4096 },
    "oy":                  { "type": "number",  "min": -4096, "max": 4096 },
    "movable":             { "type": "boolean" },
    "angle":               { "type": "number",  "min": -360, "max": 360 },
    "scale":               { "type": "number",  "min": 0.2, "max": 8.0 },
    "randomScale":         { "type": "boolean" },
    "color":               { "type": "number" },
    "randomColor":         { "type": "boolean" },
    "subColor":            { "type": "number" },
    "stay":                { "type": "number",  "min": 4, "max": 72000 },
    "activeHold":          { "type": "number",  "min": 4, "max": 72000 },
    "fadeStyle":           { "type": "string",  "enum": ["shrink", "char_first", "char_last", "blink", "shatter", "blur", "split", "random"] },
    "fadeOut":             { "type": "number",  "min": 0, "max": 1200 },
    "typewriter":          { "type": "boolean" },
    "charMs":              { "type": "number",  "min": 8, "max": 2000 },
    "cursor":              { "type": "string",  "maxLen": 16 },
    "shadow":              { "type": "boolean" },
    "letterSpacing":       { "type": "number",  "min": -2.0, "max": 24.0 },
    "letterSpacingMode":   { "type": "string",  "enum": ["relative", "fixed"] },
    "outlineMode":         { "type": "string",  "enum": ["none", "stroke", "glow", "mui_stroke"] },
    "outlineColor":        { "type": "number" },
    "outlineWidth":        { "type": "number",  "min": 0.2, "max": 2.5 },
    "jitter":              { "type": "boolean" },
    "perCharShake":        { "type": "boolean" },
    "shakeMode":           { "type": "string",  "enum": ["none", "constant", "decay", "fade_in", "pulse", "per_char", "random"] },
    "charShakeStyle":      { "type": "string" },
    "charShakeShift":      { "type": "number",  "min": 0 },
    "charShakeShiftX":     { "type": "number",  "min": 0 },
    "charShakeShiftY":     { "type": "number",  "min": 0 },
    "charShakeSwayX":      { "type": "number",  "min": 0 },
    "charShakeSwayY":      { "type": "number",  "min": 0 },
    "charShakeRotDeg":     { "type": "number",  "min": 0, "max": 45 },
    "charShakeWin":        { "type": "number",  "min": 0.05, "max": 1.0 },
    "charShakeSnap":       { "type": "boolean" },
    "charShakeTransition": { "type": "string" },
    "shakeAmp":            { "type": "number",  "min": 0 },
    "shakeFreqMin":        { "type": "number",  "min": 0 },
    "shakeFreqMax":        { "type": "number",  "min": 0 },
    "randomShake":         { "type": "boolean" },
    "maxWidth":            { "type": "number",  "min": 0 },
    "wrap":                { "type": "boolean" },
    "clamp":               { "type": "boolean" },
    "showInGui":           { "type": "boolean" },
    "maxGroup":            { "type": "number",  "min": 0 },
    "restart":             { "type": "boolean" },
    "debug":               { "type": "boolean" },
    "cost":                { "type": "number",  "min": 0 },
    "vars":                { "type": "object" },
    "tracks":              { "type": "object" },
    "clip":                { "type": "object" },
    "nodes":               { "type": "array" },
    "bgNodes":             { "type": "array" },
    "fgNodes":             { "type": "array" },
    "targetGui":           { "type": "object" },
    "replaceTextures":     { "type": "object" },
    "slotMatch":           { "type": "object" },
    "worldPos":            { "type": "vec3" },
    "billboard":           { "type": "string",  "enum": ["center", "vertical", "fixed"] },
    "seeThrough":          { "type": "boolean" },
    "yaw":                 { "type": "number",  "min": -360, "max": 360 },
    "pitch":               { "type": "number",  "min": -180, "max": 180 },
    "roll":                { "type": "number",  "min": -360, "max": 360 },
    "maxDistance":         { "type": "number",  "min": 2, "max": 512 },
    "dimension":           { "type": "string",  "maxLen": 128 },
    "_fromProto":          { "type": "number",  "enum": [5] }
  },
  "node": {
    "types": ["rect", "sprite", "nine_slice", "item", "text", "group"],
    "anchors": ["center", "top_left", "left", "top_right", "right"],
    "commonFields": ["id", "type", "x", "y", "anchor", "w", "h", "scale", "angle", "alpha", "clip", "bind"]
  },
  "fill": {
    "modes": ["solid", "outline", "gradient", "parallax", "shader"]
  },
  "clip": {
    "dirs": ["left", "right", "up", "down", "center_x"],
    "modes": ["local", "scissor"]
  },
  "track": {
    "modes": ["lerp", "trail", "impulse"]
  }
}
